# Entorno para compilar el motor de OrcaSlicer (mismo sistema que su CI de Linux).
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build clang lld git wget curl ca-certificates file \
    autoconf automake libtool texinfo m4 pkg-config gettext \
    libssl-dev libcurl4-openssl-dev libfreetype-dev libfontconfig-dev \
    libgl-dev libglu1-mesa-dev libegl-dev libglfw3-dev libglew-dev libdbus-1-dev \
    libgtk-3-dev libudev-dev extra-cmake-modules \
    && rm -rf /var/lib/apt/lists/*
