{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinocchio",
  "version": "0.1.0",
  "identifier": "com.pinocchio.app",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../web" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../web" }
  },
  "app": {
    "windows": [
      {
        "title": "Pinocchio - Auto Rigging",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
