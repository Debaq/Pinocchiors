{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinocchio",
  "version": "0.1.0",
  "identifier": "com.pinocchio.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../web" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../web" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pinocchio - Auto Rigging",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#0b0b0d",
        "maximized": true,
        "visible": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "title": "Pinocchio",
        "width": 560,
        "height": 336,
        "resizable": false,
        "decorations": false,
        "center": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3QjJCMThBMzM4NzE3REYKUldUZkY0Y3ppckd5MTJBdFVoYnlCdzMrM3B2ay8vM25rY1RJc0Jxc2hTNk5vMm4vNUE5QnhkaXcK",
      "endpoints": ["https://github.com/Debaq/Pinocchiors/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
